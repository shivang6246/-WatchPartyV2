# Secrets. Never commit these.
.env
.env.local
*.pem
*.key

# Build output
backend/target/
frontend/.next/
frontend/out/
frontend/node_modules/
node_modules/
# Generated by Next and tsc on every build
next-env.d.ts
*.tsbuildinfo

# Runtime artefacts that have leaked into repositories before
*.log
dump.rdb
appendonly.aof

# Editors
.idea/
.vscode/
*.iml
.DS_Store
