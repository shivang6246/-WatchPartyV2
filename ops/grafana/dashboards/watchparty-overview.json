{
  "uid": "watchparty-overview",
  "title": "WatchParty overview",
  "tags": [
    "watchparty"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active rooms",
      "description": "Open rooms as of the last 30s snapshot sweep.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(watchparty_rooms_active)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "WebSocket sessions",
      "description": "Summed across instances.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(watchparty_ws_sessions)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Resyncs (1h)",
      "description": "Clients that drifted past 30s. Each is logged as a sync defect; this should be near zero.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(watchparty_sync_corrections_total{tier=\"resync\"}[1h]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Host failovers (24h)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(watchparty_host_failovers_total{outcome=\"transferred\"}[24h]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Drift corrections per minute, by tier",
      "description": "rate is the gentle tier. A rising seek or resync line means clock sync or network assumptions are wrong.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tier) (rate(watchparty_sync_corrections_total[5m])) * 60",
          "legendFormat": "{{tier}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Share of corrections that needed a seek or resync",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(watchparty_sync_corrections_total{tier=~\"seek|resync\"}[15m])) / clamp_min(sum(rate(watchparty_sync_corrections_total[15m])), 1e-9)",
          "legendFormat": "seek + resync"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Member drift from the projection",
      "description": "From heartbeats of members who are playing and not buffering. Under 250ms is invisible.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(watchparty_sync_drift_milliseconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(watchparty_sync_drift_milliseconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(watchparty_sync_drift_milliseconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Redis Lua apply latency",
      "description": "The script that sequences and stores every playback event.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(watchparty_redis_apply_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(watchparty_redis_apply_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Playback events by result",
      "description": "Per minute. rate_limited or room_locked spikes point at a misbehaving client.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(watchparty_playback_events_total[5m])) * 60",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Chat and reactions per minute",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(watchparty_chat_messages_total[5m])) * 60",
          "legendFormat": "chat"
        },
        {
          "refId": "B",
          "expr": "sum(rate(watchparty_reactions_total[5m])) * 60",
          "legendFormat": "reactions"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Host failovers and room closures",
      "description": "Hourly counts.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(watchparty_host_failovers_total[1h]))",
          "legendFormat": "failover: {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (increase(watchparty_rooms_closed_total[1h]))",
          "legendFormat": "closed: {{reason}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Moderation and queue",
      "description": "Hourly counts.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(watchparty_members_kicked_total[1h]))",
          "legendFormat": "kicks"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (increase(watchparty_queue_advanced_total[1h]))",
          "legendFormat": "queue: {{reason}}"
        }
      ]
    }
  ]
}
