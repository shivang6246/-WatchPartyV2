# Copy to backend/.env.local (gitignored) for running the backend outside
# Docker, e.g. from an IDE or with mvn spring-boot:run. Docker Compose does not
# read this file; it takes the same values from the root .env.

# Supabase > Project > Connect > Session pooler, rewritten as a JDBC URL:
DATABASE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USER=postgres.YOUR_PROJECT_REF
DATABASE_PASSWORD=

# Base64, 32+ bytes: openssl rand -base64 48
JWT_SECRET=

# Leave blank for a local Redis with no password.
REDIS_PASSWORD=

# Leave SMTP_HOST blank to have verification mail written to the log, which is
# also what keeps an unverified account able to host on a dev machine.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=WatchParty <no-reply@localhost>
WEB_BASE_URL=http://localhost:3000
