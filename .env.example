# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Generate the two secrets with:
#   openssl rand -base64 48

# ---- Database: Supabase (Postgres) -----------------------------------------
# Supabase > your project > Connect > "Session pooler" (port 5432; works over
# IPv4, where the direct connection is IPv6-only on most plans). Rewrite the
# URI it shows as JDBC and put the user and password in their own variables:
#   postgresql://postgres.abcd1234:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# becomes
#   DATABASE_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
#   DATABASE_USER=postgres.abcd1234
#   DATABASE_PASSWORD=[PASSWORD]
# Tables are created on first start (Flyway) in a "watchparty" schema, not
# "public", so Supabase's auto-generated REST API does not expose them.
#
# Or run the bundled local Postgres instead:
#   DATABASE_URL=jdbc:postgresql://postgres:5432/watchparty
#   DATABASE_USER=watchparty
#   DATABASE_PASSWORD=<same as POSTGRES_PASSWORD>
#   docker compose --profile local-db up -d
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5
# Only used by the bundled local Postgres container.
POSTGRES_USER=watchparty
POSTGRES_DB=watchparty
POSTGRES_PASSWORD=

REDIS_PASSWORD=

# Must decode to at least 32 bytes. Rotating it invalidates existing sessions
# unless you drain them; tokens carry a kid header so you can stage a rotation.
JWT_SECRET=
JWT_KEY_ID=k1

# Explicit allowlist. A wildcard cannot be used with credentialed requests
# anyway, and would let any site call this API on a signed-in visitor's behalf.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# The published extension, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
CORS_ALLOWED_EXTENSION_IDS=

# Set to true once you are serving over HTTPS.
REFRESH_COOKIE_SECURE=false

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_GOOGLE_ENABLED=false

ROOM_MAX_MEMBERS=25
# A host who drops keeps the room this long before it passes to the
# longest-standing registered member still watching.
ROOM_HOST_GRACE=45s
# A room with nobody connected closes after this long.
ROOM_EMPTY_GRACE=10m
ROOM_MAX_QUEUE=50

# ---- In-app YouTube browsing ----------------------------------------------
# A YouTube Data API v3 key (Google Cloud console -> APIs -> YouTube Data API).
# Without it the picker still works: you paste a link instead of searching.
YOUTUBE_API_KEY=
YOUTUBE_REGION=US

# ---- Email ------------------------------------------------------------------
# Any SMTP provider (Resend, Brevo, SES, Postmark, Gmail). Leave SMTP_HOST blank
# and verification mail is written to the backend log instead, with nothing held
# back — which is what you want on a development machine.
#
# With a host set, a new account must confirm its address before it can host a
# room. Joining as a guest never needs an account, so invited friends are
# unaffected. VERIFICATION_REQUIRED=false turns the requirement off even with
# mail configured; true turns it on without.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=WatchParty <no-reply@yourdomain.com>
VERIFICATION_TTL=24h
VERIFICATION_REQUIRED=
# Where the links in those emails point, i.e. your web client.
WEB_BASE_URL=http://localhost:3000

# Optional. Google sign-in endpoints return 503 until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_POST_LOGIN_REDIRECT=http://localhost:3000/auth/callback

# Used by the proxy profile. Caddy issues a real certificate for a real domain.
SITE_ADDRESS=localhost

# ---- Observability ----------------------------------------------------------
# Backend log shape in Docker: ecs (default), logstash or gelf.
LOG_FORMAT=ecs
# Grafana admin password for the observability profile.
GRAFANA_PASSWORD=
